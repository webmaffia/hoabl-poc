# Optional: HeyGen LiveAvatar integration for Aira.
# The app works fully without these — it falls back to a local/demo avatar
# presentation (animated portrait + talking state + captions).
#
# 1. Get an API key AND create an avatar at https://app.liveavatar.com/developers
#    — this is a SEPARATE account/product from the classic app.heygen.com
#    dashboard. A classic HeyGen API key will NOT work here (it authenticates
#    against api.heygen.com, not api.liveavatar.com — confirmed: it returns a
#    401 "Invalid API key" if you try it).
# 2. Copy this file to .env.local and fill in the values below.
# 3. Restart `npm run dev`.
#
# IMPORTANT: neither var has a "NEXT_PUBLIC_" prefix, on purpose — both are
# only ever read server-side, in app/api/heygen/token/route.ts, which
# exchanges them for a short-lived session token. That token (not the key) is
# what reaches the browser.

HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# REQUIRED (set exactly one) — HeyGen's "FULL" session mode (needed for
# built-in text-to-speech; see app/api/heygen/token/route.ts) requires a
# voice_agent or context resource. These are dashboard-only — there's no API
# to create one. Look in app.liveavatar.com for a "Voice Agents", "Personas",
# or "Contexts" section, create the simplest one (just a voice, no LLM needed
# — this app supplies its own scripted text), and paste its id below.
HEYGEN_VOICE_AGENT_ID=
HEYGEN_CONTEXT_ID=

# Optional — "true" only if your avatar is enabled for sandbox/trial mode
# (some avatars return "not supported in sandbox mode" — if so, use false).
HEYGEN_SANDBOX=false
